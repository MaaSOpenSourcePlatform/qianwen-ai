        "description": "上传参数",
        "properties": {
          "name": {
            "description": "上传的文件名，需要带后缀",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    "required": [
      "fieldName_0"
    ],
    "type": "object"
  },
  "outputSchema": {
    "description": "AtaPojoResult<CalculatePostSignatureClientDTO> OSS 上传签名",
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "description": "是否成功"
      },
      "errorCode": {
        "type": "string",
        "description": "错误编码"
      },
      "errorMsg": {
        "type": "string",
        "description": "错误信息"
      },
      "traceId": {
        "type": "string",
