{
  "version": 1,
  "id": "ata::oss-calculate-post-signature",
  "description": "生成一个文件、图片上传的签名，然后上传；",
  "javaMethod": "com.alibaba.atasuper.client.v2.oss.OssClientClientService#calculatePostSignature",
  "inputSchema": {
    "description": "生成一个文件、图片上传的签名，然后上传；",
    "properties": {
